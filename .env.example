# Copy to .env.local for development. Never commit real keys.

# OpenAI-compatible LLM provider (BoxAPI). If unset, the assistant runs in rule-based mode.
BOXAPI_API_KEY=
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
BOXAPI_MODEL=gpt-5.4-mini
# Set to 1 to force rule-based mode even when a key exists (tests, offline demo).
LLM_DISABLED=0

# Optional: custom SQLite path (default: ./data/torob.db)
# DB_PATH=
